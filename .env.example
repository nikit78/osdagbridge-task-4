# This is a top-level overview of environment variables used across this repository.
# Each backend has its own detailed .env.example — see:
#   custom-backend/.env.example
#   appwrite-backend/.env.example

# ---- custom-backend (Node/Express + PostgreSQL) ----
PORT=4000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=osdagbridge
DB_USER=postgres
DB_PASSWORD=your_password
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=1h

# ---- appwrite-backend (Appwrite managed backend) ----
APPWRITE_ENDPOINT=your_region_endpoint
APPWRITE_PROJECT_ID=your_project_id
APPWRITE_API_KEY=your_api_key
APPWRITE_DATABASE_ID=your_database_id
APPWRITE_FILES_TABLE_ID=files
APPWRITE_BUCKET_ID=your_bucket_id